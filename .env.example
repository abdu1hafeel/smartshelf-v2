# ==============================================================================
# SmartShelf V2 - Environment Configuration Reference
# IMPORTANT: Placeholders only. NEVER commit actual keys or secrets to git.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Supabase Project Configuration (Backend & Edge Runtime)
# ------------------------------------------------------------------------------
# Supabase project URL (e.g., https://<project-ref>.supabase.co or http://127.0.0.1:54321 for local)
SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase Anonymous Key (safe for client-side use in web/mobile)
SUPABASE_ANON_KEY=your-supabase-anon-key-here

# Supabase Service Role Key (STRICTLY for trusted server-side Edge Functions / admin CLI)
# WARNING: NEVER expose this key in client-side code (Vite, React, Flutter, or ESP32)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# ------------------------------------------------------------------------------
# 2. Admin Web Application (Vite / React)
# ------------------------------------------------------------------------------
# Exposed to Vite client build (prefixed with VITE_)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# ------------------------------------------------------------------------------
# 3. Shopkeeper Mobile App (Flutter)
# Passed via --dart-define during build/run or loaded via secure config asset
# ------------------------------------------------------------------------------
FLUTTER_SUPABASE_URL=https://your-project-ref.supabase.co
FLUTTER_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# ------------------------------------------------------------------------------
# 4. ESP32 Scale Controller Firmware (Provisioned per hardware unit)
# ------------------------------------------------------------------------------
WIFI_SSID=YourRetailWifiSSID
WIFI_PASSWORD=YourRetailWifiPassword
SCALE_TELEMETRY_URL=https://your-project-ref.supabase.co/functions/v1/scale-telemetry
DEVICE_ID=00000000-0000-0000-0000-000000000001
DEVICE_SECRET=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
DEFAULT_PRODUCT_ID=00000000-0000-0000-0000-000000000002
